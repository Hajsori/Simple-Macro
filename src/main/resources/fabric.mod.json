{
  "schemaVersion": 1,
  "id": "simplestreamdeck",
  "version": "${version}",
  "name": "Simple Stream Deck",
  "description": "With Simple Stream Deck you can control Simple Voice Chat with your Stream Deck",
  "authors": [],
  "contact": {},
  "license": "All-Rights-Reserved",
  "icon": "assets/simplestreamdeck/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "xyz.hajsori.simplestreamdeck.client.SimpleStreamDeckClient"
    ],
    "main": [
      "xyz.hajsori.simplestreamdeck.SimpleStreamDeck"
    ],
    "voicechat": [
      "xyz.hajsori.simplestreamdeck.SimpleStreamDeckVoicechatPlugin"
    ]
  },
  "mixins": [
    "simplestreamdeck.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}"
  }
}
